# Smart Parking Occupancy Analytics — Configuration
# Course: AI372IA, RV College of Engineering, Bengaluru

# ─────────────────────────────────────────────────────────────
# KAFKA BROKER (Docker container)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=raw-parking-events
KAFKA_TOPIC_AGGREGATED=aggregated-occupancy-stats
KAFKA_TOPIC_DLQ=parking-events-dlq

# ─────────────────────────────────────────────────────────────
# INFLUXDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=parking-super-secret-token
INFLUXDB_ORG=rv-college
INFLUXDB_BUCKET=parking_analytics

# ─────────────────────────────────────────────────────────────
# GRAFANA
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=parking123

# ─────────────────────────────────────────────────────────────
# SPARK
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=./checkpoints
SPARK_TRIGGER_INTERVAL=10 seconds
SPARK_WATERMARK=2 minutes

# ─────────────────────────────────────────────────────────────
# LIVE REAL-TIME EXTERNAL SMART PARKING API KEY
# Course: AI372IA — Stream Processing and Analytics
PARKING_API_KEY=pk_live_rvce_spa_melbourne_iot_2026

